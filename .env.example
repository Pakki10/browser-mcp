# --- Required ---
DATABASE_URL="postgresql://admin:admin@db:5432/browser_mcp"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3013"

# Public base URL that OAuth callbacks point at.
# In prod set to https://browser.regiq.in.
PUBLIC_BASE_URL="http://localhost:3013"

# Encryption key for stored credentials — 32 bytes as hex (64 hex chars).
# Generate with: openssl rand -hex 32
# NEVER commit. NEVER reuse across environments. Rotating this invalidates
# every saved credential in the DB.
CRED_ENCRYPTION_KEY=""

# --- Sign-in providers (add any subset; unset providers are hidden) ---

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub — https://github.com/settings/applications/new
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- No LLM in this stack ---
# Your agent supplies the model. This skill just drives the browser.
