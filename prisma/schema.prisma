generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  apiKeys     ApiKey[]
  browserSessions BrowserSession[]
  credentials StoredCredential[]
  browserState UserBrowserState?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- MCP API keys ---
// Raw key format: `br_live_<48 hex>`. SHA-256 hash stored; raw shown once.

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Browser sessions ---
// One row per browser_new_session call. Actual Playwright BrowserContext +
// Page live in the process's in-memory Map; this DB row is just for audit
// and cleanup by the sweeper. `expiresAt` is set to now + 15 min at each
// tool call.

model BrowserSession {
  id           String    @id
  userId       String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  closedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// --- Per-user Chrome storage state ---
// One row per user. `state` holds the JSON output of
// `browserContext.storageState()` — cookies + localStorage + IndexedDB
// snapshot. Restored on `browser_new_session` so logins persist across
// sessions AND container rebuilds. Saved on every session close (explicit +
// idle sweep). Wiping this row logs the user out of every site.

model UserBrowserState {
  userId    String   @id
  state     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Stored credentials ---
// One row per (user, domain). username is stored plaintext (used for display
// on the dashboard); password is encrypted with AES-256-GCM via CRED_ENCRYPTION_KEY.
// Never returned raw over the MCP API — only typed into browser fields.

model StoredCredential {
  id                String   @id @default(cuid())
  userId            String
  domain            String
  username          String
  passwordEncrypted String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
}
